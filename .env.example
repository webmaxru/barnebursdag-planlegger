# Kassal.app API key (https://kassal.app) – used server-side only for live price lookups.
# In production this is an Azure Static Web Apps API environment variable.
# The app works without it; the "Vis priser" feature is disabled when empty.
KASSAL_API_KEY=

# Port for the local Express development/E2E adapter.
PORT=8080

# Browser configuration is embedded by Vite at build time and is public in the
# generated JavaScript. Changing these values requires a rebuild.
VITE_FEATURE_MENY_CART=

# Cookieless browser analytics connection string (intentionally client-visible).
VITE_ANALYTICS_ENABLED=
VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=
